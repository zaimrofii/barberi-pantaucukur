{
  "project": {
    "name": "PantauCukur (Barberi Backend)",
    "version": "2.0.0",
    "type": "Django Backend + AI Computer Vision",
    "stack": "Django 6.0.4 + YOLOv8-Pose + OpenCV + Channels",
    "status": "PRODUCTION READY ✅",
    "last_updated": "2026-08-18"
  },
  "architecture": {
    "components": {
      "django": "REST API + WebSocket + Database",
      "ai_engine": "YOLOv8-Pose person detection + keypoint estimation",
      "tracker": "SimpleByteTrack (custom, fixed)",
      "realtime": "WebSocket over ASGI for live updates",
      "redis": "Frame cache between AI and Django (5s TTL)"
    },
    "flow": "AI Engine → Redis → Django API → DB → WebSocket → Frontend"
  },
  "file_structure": {
    "core": {
      "models.py": {
        "key_classes": ["BarberSession"],
        "fields": [
          "chair_number (IntegerField)",
          "start_time/end_time (DateTimeField)",
          "duration_seconds (IntegerField)",
          "is_valid (BooleanField)",
          "confidence_score (IntegerField, 0-100)",
          "tracking_data (JSONField)",
          "session_status (CharField: PENDING/ACTIVE/ENDED)",
          "last_heartbeat (DateTimeField)",
          "timeout_reason (CharField, nullable)",
          "ended_by (CharField: AI/TIMEOUT/MANUAL)"
        ]
      },
      "views.py": {
        "endpoints": [
          "start_session",
          "end_session",
          "update_session",
          "heartbeat",
          "get_sessions_summary",
          "get_current_summary_data",
          "get_session_detail",
          "get_session_metrics"
        ]
      },
      "consumers.py": {
        "key_classes": ["ChatConsumer"],
        "messages": [
          "STATUS_UPDATE (chair_id, is_occupied, confidence_score, session_status)",
          "INITIAL_CONNECTION (full summary data)"
        ]
      },
      "urls.py": {
        "endpoints": [
          "/api/session/start/",
          "/api/session/end/",
          "/api/session/update/",
          "/api/session/heartbeat/",
          "/api/session/summary/",
          "/api/session/{id}/detail/",
          "/api/session/metrics/"
        ]
      }
    },
    "services": {
      "detector.py": {
        "description": "YOLOv8-Pose detector orchestrator with SimpleByteTrack",
        "responsibilities": [
          "Initialize YOLO model and SimpleByteTrack tracker",
          "Orchestrate detection→tracking→scoring pipeline",
          "Coordinate specialized managers",
          "Draw UI overlay"
        ],
        "tracker_config": {
          "match_thresh": 0.4,
          "grace_period": 5,
          "min_hits": 3,
          "max_age": 30
        }
      },
      "state_machine.py": {
        "key_classes": ["StateMachine"],
        "states": ["IDLE", "PENDING", "ACTIVE", "ENDING"],
        "transitions": [
          "IDLE→PENDING: 2 persons detected for 30s",
          "PENDING→ACTIVE: score ≥ 70",
          "ACTIVE→ENDING: score < 70 for 10s OR timeout 5min",
          "ENDING→IDLE: cooldown 5s"
        ]
      },
      "scoring_engine.py": {
        "key_classes": ["ScoringEngine"],
        "weights": {
          "hand_activity": 0.35,
          "posture": 0.2,
          "temporal": 0.25,
          "person_count": 0.2
        },
        "thresholds": {
          "min_valid_duration": 180,
          "scoring_threshold": 70,
          "pending_duration": 30,
          "confirmation_window": 10
        },
        "posture_score_logic": {
          "description": "Sederhana & Robust - 2 orang + tepat 1 STANDING = 100",
          "rules": [
            "If person_count < 2 → 0",
            "If standing_count == 0 → 0 (no barber)",
            "If standing_count >= 2 → 0 (both standing, chatting)",
            "If person_count >= 2 AND standing_count == 1 → 100"
          ],
          "key_insight": "Customer with cape = NOT STANDING. Barber = STANDING. Tepat 1 standing = sesi cukur aktif."
        }
      },
      "posture_classifier.py": {
        "key_classes": ["PostureClassifier"],
        "signals": [
          "Area ratio (bbox width/height)",
          "Shoulder-hip distance (vertical_diff relative to bbox height)",
          "Location fallback (inside ROI = SITTING for customers with cape)",
          "Temporal consistency (10-frame window)"
        ],
        "thresholds": {
          "area_ratio": 0.55,
          "vertical_diff": 0.20,
          "temporal_window": 10,
          "min_consistent_frames": 5,
          "keypoints_reliable": "min 2 body keypoints (shoulders/hips only, NOT face)"
        },
        "key_fix": "Only count BODY keypoints (shoulders/hips). Face keypoints ignored for reliability check."
      },
      "hand_activity.py": {
        "key_functions": ["calculate_hand_activity", "is_barber_for_chair"],
        "responsibilities": [
          "Calculate hand activity points (0-5 per frame)",
          "Filter to barber only (standing + proximity)",
          "Hybrid head detection: face bbox → nose → shoulder avg"
        ],
        "barber_identification": {
          "method": "Posture-based (not location-based)",
          "criteria": "STANDING posture + within 300px of chair center",
          "temporal": "Majority vote from last 10 frames"
        }
      },
      "track_manager.py": {
        "key_classes": ["TrackManager"],
        "responsibilities": [
          "Maintain trajectories per track_id",
          "Posture and hand activity history",
          "Barber vs customer identification (posture-based)",
          "Cleanup inactive tracks (>60s)"
        ],
        "barber_identification": {
          "method": "Posture-based (STANDING), NOT location-based",
          "temporal": "10-frame majority vote",
          "proximity_threshold": 300
        }
      },
      "roi_manager.py": {
        "key_classes": ["ROIManager"],
        "responsibilities": [
          "Maintain ROI list per chair",
          "Check occupancy with anti-flickering (5 frames)",
          "Count persons in ROI"
        ]
      },
      "network.py": {
        "key_classes": ["PantauNetwork"],
        "methods": [
          "report_status_change() - legacy",
          "report_session_update() - full scoring data",
          "send_heartbeat() - keepalive"
        ],
        "data": [
          "chair_id",
          "is_active",
          "confidence_score",
          "session_status",
          "timestamp"
        ]
      },
      "main.py": {
        "key_functions": ["main"],
        "loop": [
          "Read frame from camera",
          "Process AI detection",
          "Get session_data from state machine",
          "Send updates if status_changed",
          "Heartbeat every 30s"
        ]
      }
    }
  },
  "api_endpoints": {
    "POST /api/session/start/": {
      "request": {
        "chair_id": "int",
        "confidence_score": "int",
        "session_status": "str"
      },
      "response": { "status": "str", "session_id": "int", "message": "str" },
      "effect": "Creates BarberSession, triggers WebSocket"
    },
    "POST /api/session/end/": {
      "request": {
        "chair_id": "int",
        "confidence_score": "int",
        "session_status": "str",
        "ended_by": "str"
      },
      "response": {
        "status": "str",
        "duration": "int",
        "is_valid": "bool",
        "confidence_score": "int"
      },
      "effect": "Updates BarberSession, triggers WebSocket"
    },
    "POST /api/session/update/": {
      "request": {
        "chair_id": "int",
        "confidence_score": "int",
        "session_status": "str"
      },
      "effect": "Updates session status, triggers WebSocket"
    },
    "POST /api/session/heartbeat/": {
      "request": { "chair_id": "int", "timestamp": "str" },
      "effect": "Updates last_heartbeat"
    },
    "GET /api/session/summary/": {
      "response": {
        "summary": { "total_valid": "int", "total_invalid": "int" },
        "valid_list": "array",
        "invalid_list": "array"
      }
    },
    "GET /api/session/{id}/detail/": {
      "response": {
        "id": "int",
        "chair_number": "int",
        "duration_seconds": "int",
        "is_valid": "bool",
        "confidence_score": "int",
        "session_status": "str",
        "score_breakdown": {
          "posture": "int",
          "hand_activity": "int",
          "temporal": "int",
          "person_count": "int"
        }
      }
    },
    "GET /api/session/metrics/": {
      "response": {
        "chair_id": "int",
        "current_score": "int",
        "current_status": "str",
        "duration": "int",
        "person_count": "int"
      }
    },
    "GET /api/camera/frame/": {
      "response": { "status": "str", "frame": "base64", "rois": "array" }
    },
    "POST /api/roi/update/": {
      "request": { "rois": "array" },
      "response": { "status": "str", "message": "str" }
    }
  },
  "websocket": {
    "endpoint": "ws://[host]/ws/test/",
    "messages": {
      "INITIAL_CONNECTION": { "trigger": "On connect", "data": "Full summary" },
      "STATUS_UPDATE": {
        "data": {
          "type": "str",
          "chair_id": "int",
          "is_occupied": "bool",
          "confidence_score": "int",
          "session_status": "str",
          "message": "str",
          "updated_summary": "object"
        }
      }
    }
  },
  "ai_config": {
    "model": "YOLOv8n-Pose",
    "confidence_threshold": 0.5,
    "keypoint_conf": 0.3,
    "occupancy_ratio": 0.4,
    "anti_flickering": { "frames": 5 },
    "tracking": {
      "tracker": "SimpleByteTrack (custom implementation)",
      "match_thresh": 0.4,
      "grace_period": 5,
      "min_hits": 3,
      "max_age": 30,
      "timeout_seconds": 60,
      "cleanup_frames": 300
    },
    "session_timeout": { "seconds": 300, "heartbeat_frames": 900 },
    "scoring": {
      "weights": {
        "hand_activity": 0.35,
        "posture": 0.2,
        "temporal": 0.25,
        "person_count": 0.2
      },
      "thresholds": {
        "min_valid_duration": 180,
        "scoring_threshold": 70,
        "pending_duration": 30,
        "confirmation_window": 10
      },
      "posture_score": {
        "logic": "person_count >= 2 AND standing_count == 1 → 100",
        "key_insight": "Tidak perlu deteksi SITTING. Cukup deteksi STANDING."
      }
    },
    "hand_activity": {
      "head_detection": "hybrid (face→nose→shoulders)",
      "face_confidence": 0.3,
      "head_expand_ratio": 1.5,
      "barber_standing_threshold": 0.5,
      "barber_proximity": 100
    },
    "barber_identification": {
      "method": "Posture-based (STANDING), NOT location-based",
      "temporal": "10-frame majority vote",
      "proximity_threshold": 300,
      "key_fix": "No longer skips people inside ROI"
    },
    "posture_classifier": {
      "keypoint_check": "ONLY body keypoints (shoulders/hips). Face keypoints ignored.",
      "fallback": "Inside ROI + no body keypoints = SITTING (customer with cape)",
      "vertical_diff": "Calculated relative to bbox height, NOT frame_height",
      "thresholds": {
        "area_ratio": 0.55,
        "vertical_diff": 0.20
      }
    }
  },
  "database_schema": {
    "BarberSession": {
      "fields": {
        "id": "BigAutoField",
        "chair_number": "IntegerField",
        "start_time": "DateTimeField",
        "end_time": "DateTimeField (nullable)",
        "duration_seconds": "IntegerField",
        "is_valid": "BooleanField",
        "confidence_score": "IntegerField",
        "tracking_data": "JSONField",
        "session_status": "CharField (PENDING/ACTIVE/ENDED)",
        "last_heartbeat": "DateTimeField",
        "timeout_reason": "CharField (nullable)",
        "ended_by": "CharField (AI/TIMEOUT/MANUAL)"
      },
      "ordering": ["-start_time"]
    }
  },
  "workflows": {
    "occupancy": [
      "Camera captures frame",
      "YOLOv8 detects persons + keypoints",
      "SimpleByteTrack tracks unique IDs (fixed: grace_period prevents premature deletion)",
      "Detector compares with ROIs",
      "ROIManager applies smoothing",
      "State machine determines state",
      "API call to Django with scoring",
      "Database update + WebSocket broadcast"
    ],
    "session_lifecycle": {
      "start": [
        "2 persons detected for 30s → PENDING",
        "Score ≥ 70 → ACTIVE",
        "POST /api/session/start/",
        "Create BarberSession",
        "WebSocket broadcast"
      ],
      "end": [
        "Person left or score < 70 for 10s → ENDING",
        "POST /api/session/end/",
        "Calculate duration",
        "Mark valid if >180s and score≥70",
        "WebSocket broadcast"
      ],
      "timeout": [
        "No heartbeat for 5min → ENDING",
        "POST /api/session/end/ with ended_by=TIMEOUT",
        "Mark invalid",
        "WebSocket broadcast"
      ]
    }
  },
  "logging": {
    "status": "IMPLEMENTED",
    "logger_file": "PantauCukur/core/services/logger.py",
    "log_location": "PantauCukur/core/services/logs/ai_engine.jsonl",
    "log_format": "JSONL (structured)",
    "level": "DEBUG (production: INFO)",
    "events_implemented": [
      "REDIS_CONNECTED",
      "ENGINE_START",
      "CONFIG_LOADED",
      "MODEL_LOADING",
      "MODEL_LOADED",
      "NETWORK_INIT",
      "CAMERA_CONNECTING",
      "ENGINE_RUNNING",
      "INFERENCE_COMPLETE",
      "POSTURE_CLASSIFIED",
      "HAND_ACTIVITY_CALCULATED",
      "SCORE_CALCULATED",
      "POSTURE_SCORE_DEBUG (INFO level)",
      "STATE_TRANSITION",
      "BARBER_CANDIDATE_CHECK"
    ]
  },
  "dependencies": {
    "django": {
      "Django": "6.0.4",
      "channels": "4.3.2",
      "daphne": "4.2.1",
      "cors-headers": "4.9.0",
      "channels-redis": "4.3.0"
    },
    "ai": {
      "ultralytics": "8.4.37",
      "opencv": "4.13.0.92",
      "torch": "2.11.0",
      "torchvision": "0.26.0"
    },
    "network": { "requests": "2.33.1", "redis": "5.2.1" }
  },
  "constants": {
    "min_session_duration": 180,
    "occupancy_threshold": 0.4,
    "anti_flickering_frames": 5,
    "keypoint_conf": 0.3,
    "network_timeout": 0.5,
    "scoring_threshold": 70,
    "pending_duration": 30,
    "session_timeout": 300,
    "track_timeout": 60,
    "tracker_match_thresh": 0.4,
    "tracker_grace_period": 5,
    "posture_vertical_diff_threshold": 0.20,
    "barber_proximity_threshold": 300
  },
  "fixes_applied": [
    "Memory leak: Track cleanup every 300 frames",
    "False standing: Multi-signal posture detection",
    "Hand activity: Barber filtering (customers excluded)",
    "Head detection: Hybrid method (face→nose→shoulders)",
    "Session timeout: Watchdog timer auto-ends after 5min",
    "Tracker: SimpleByteTrack.grace_period prevents premature track deletion",
    "Tracker: match_thresh lowered from 0.8 to 0.4 for SKIP_FRAMES=10",
    "Posture: _has_reliable_keypoints() now only counts body keypoints (shoulders/hips), not face",
    "Posture: vertical_diff calculated relative to bbox height (not frame_height)",
    "Posture: Fallback location for customers with cape (inside ROI = SITTING)",
    "Scoring: calculate_posture_score() simplified to '2 people + exactly 1 standing = 100'",
    "Scoring: POSTURE_SCORE_DEBUG logging level changed from DEBUG to INFO",
    "Scoring: Filter out STANDING tracks inside ROI (they are barbers, not customers)",
    "Hand activity: is_barber_for_chair() now posture-based (not location-based)",
    "Hand activity: 10-frame majority vote for barber identification",
    "Person count: includes barber (barber + customer = 2)",
    "tracked_objects: passed to scoring_engine.calculate() for barber identification"
  ],
  "test_scenarios": [
    "Normal haircut 15min → ACTIVE + score > 70 (posture=100)",
    "Customer waiting 5min → INACTIVE + score < 50",
    "Barber gets tool 5sec → remains ACTIVE",
    "Barber facing away → remains ACTIVE",
    "Customer pays at counter → ENDED",
    "Barber resting in chair → INACTIVE",
    "Customer playing phone → not counted as hand activity",
    "AI crash → auto-ends after 5min timeout",
    "2 people standing and chatting → score < 70 (posture=0, because standing_count=2)",
    "Customer with cape sitting + barber standing → posture=100 ✅"
  ],
  "deployment": {
    "development": "InMemoryChannelLayer (single process)",
    "production": "Redis channel layer required",
    "settings": {
      "DEBUG": "True",
      "CORS_ALLOW_ALL": "True",
      "ALLOWED_HOSTS": "[]"
    }
  },
  "common_issues": [
    "Flickering: Fixed with 5-frame threshold",
    "Network failure: AI continues running",
    "Session validation: Must meet duration AND score",
    "WebSocket: Handle INITIAL_CONNECTION and STATUS_UPDATE differently",
    "Tracker: Fixed with grace_period and match_thresh=0.4",
    "Posture: Fixed with body-keypoint-only check and fallback location",
    "Scoring: Fixed with simplified '2 people + exactly 1 standing' logic",
    "Barber detection: Fixed with posture-based identification (not location-based)",
    "Hand activity: Fixed with chair_id propagation and posture-based barber filtering",
    "Person count: Fixed by including barber in count"
  ],
  "frontend_integration": {
    "websocket": "ws://[host]/ws/test/",
    "message_types": ["INITIAL_CONNECTION", "STATUS_UPDATE"],
    "new_fields": [
      "confidence_score (score gauge)",
      "session_status (status badge)"
    ]
  },
  "future_improvements": [
    "Convert main.py to class-based App for multi-camera support",
    "ROI update/delete/move functionality",
    "Redis channel layer for production",
    "Authentication for API endpoints"
  ]
}