# ============================================================
# PANTAUCUKUR - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# ---------- CAMERA ----------
CAMERA_URL=C:/path/to/video.mp4

# ---------- AI MODE ----------
USE_SCORING=true
HEADLESS=false
SKIP_FRAMES=10

# ---------- SCORING WEIGHTS ----------
SCORING_HAND_WEIGHT=0.35
SCORING_POSTURE_WEIGHT=0.20
SCORING_TEMPORAL_WEIGHT=0.25
SCORING_PERSON_COUNT_WEIGHT=0.20

# ---------- THRESHOLDS ----------
SCORING_THRESHOLD=70
MIN_VALID_DURATION=180
PENDING_DURATION=30
CONFIRMATION_WINDOW=10
COOLDOWN_SECONDS=5

# ---------- SESSION TIMEOUT ----------
SESSION_TIMEOUT_SECONDS=300
SESSION_TIMEOUT_ACTION=auto_end
HEARTBEAT_INTERVAL_FRAMES=900

# ---------- POSTURE ----------
POSTURE_AREA_RATIO_THRESHOLD=0.55
POSTURE_TEMPORAL_WINDOW=10
POSTURE_MIN_CONSISTENT_FRAMES=5
POSTURE_VOTE_THRESHOLD=2

# ---------- HAND ACTIVITY ----------
HAND_ACTIVITY_CONFIDENCE_THRESHOLD=0.3
HAND_ACTIVITY_HEAD_BBOX_EXPAND=1.5
HAND_ACTIVITY_BARBER_STANDING_THRESHOLD=0.5
HAND_ACTIVITY_BARBER_PROXIMITY_THRESHOLD=100

# ---------- TRACKING ----------
TRACK_TIMEOUT_SECONDS=60
CLEANUP_INTERVAL_FRAMES=300

# ---------- NETWORK ----------
NETWORK_TIMEOUT=0.5

# ---------- REDIS ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============================================================
# LOGGER - KONFIGURASI LOGGING
# ============================================================
# Level minimum untuk handler loguru (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Level minimum untuk SmartLogger (hanya log level ini dan di atasnya)
# DEBUG=10, INFO=20, WARNING=30, ERROR=40
LOG_LEVEL_MINIMAL=INFO

# Rotasi dan retensi file log
LOG_ROTATION=100 MB
LOG_RETENTION=7 days

# Interval sampling berbasis waktu (detik) untuk log INFO/DEBUG
# Default: 5 detik. Semakin besar = semakin jarang log ditulis.
LOG_SAMPLE_INTERVAL_SECONDS=5

# Interval untuk log metrik agregat (detik)
# Setiap interval ini, SmartLogger menulis ringkasan statistik per komponen
LOG_AGGREGATE_INTERVAL_SECONDS=60

# Mode debug performa: true = aktifkan log DEBUG (lebih verbose)
# false = hanya log INFO dan di atasnya (default untuk produksi)
PERFORMANCE_DEBUG_MODE=false

# ============================================================
# DEPRECATED - Variabel lama (frame-based sampling)
# Jangan gunakan lagi. Digantikan oleh LOG_SAMPLE_INTERVAL_SECONDS
# ============================================================
# INFERENCE_LOG_SAMPLE_RATE=50
# SCORE_LOG_SAMPLE_RATE=10